      align-items: center;
    }

    .logo {
      color: #24df70;
      font-size: 22px;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      list-style: none;
    }

    .nav-links a {
      color: #d8e6dd;
      text-decoration: none;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #24df70;
    }

    /* HERO */
    .hero {
      min-height: 600px;
