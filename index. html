    }

    .hero h1 span {
      color: #24df70;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #b9c9bf;
      font-size: 18px;
    }

    .hero-buttons {
      margin-top: 32px;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      margin: 6px;
      border-radius: 9px;
      text-decoration: none;
      font-weight: bold;
    }

    .btn-primary {
      background: #24df70;
      color: #06110b;
    }

    .btn-secondary {
      border: 1px solid #24df70;
      color: #24df70;
    }

    /* GENERAL SECTIONS */
    section {
